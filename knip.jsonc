{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  // The program, its tests and the script that makes the language pages; nothing else imports them.
  "entry": ["src/main.ts", "src/pages/languages/make-language-pages.ts", "test/**/*.test.ts"],
  "project": ["src/**/*.ts", "test/**/*.ts"],
  // scripts/check.sh runs these, and Knip reads no shell script; oxlint loads oxlint-tsgolint for --type-aware.
  "ignoreDependencies": ["oxlint", "oxlint-tsgolint", "prettier"]
}
